/* 
Dark Theme - Base Styles  
=========================

Base colors and fundamental widget styling

Color Palette Reference:
- Background: #1e1e1e
- Sidebar: #252526
- Borders: #454545
- Text Primary: #cccccc
- Text Secondary: #999999
- Accent: #007acc
*/

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #cccccc;
    background-color: #1e1e1e;
}

QDialog {
    border: 1px solid #454545;
    border-radius: 3px;
}

QGroupBox {
    border: 1px solid #454545;
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 17px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.02);
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #cccccc;
}

QLabel {
    color: #cccccc;
    background-color: transparent;
}

QLabel[class="description"] {
    color: #999999;
    font-size: 13px;
}

QLabel[class="note"] {
    font-size: 12px;
}

QLabel[class="heading"] {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

QLabel[class="title"] {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
}

/* Error/warning/info message styling */
QWidget[messageType="error"] {
    background-color: #5a1d1d;
    border-left: 3px solid #f14c4c;
    color: #ffffff;
}

QWidget[messageType="warning"] {
    background-color: #5d4e1a;
    border-left: 3px solid #ffcc02;
    color: #ffffff;
}

QWidget[messageType="info"] {
    background-color: #1e3a5f;
    border-left: 3px solid #007acc;
    color: #ffffff;
}

QWidget[messageType="success"] {
    background-color: #1e5f2e;
    border-left: 3px solid #89d185;
    color: #ffffff;
}