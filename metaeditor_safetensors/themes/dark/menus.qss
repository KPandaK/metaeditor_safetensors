/* 
Dark Theme - Menus and Navigation
==================================

Menu and navigation styling.

*/

QMenuBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #454545;
    padding: 0px;
    font-size: 13px;
    color: #cccccc;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 0px;
    color: #cccccc;
    background-color: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2a2d2e;
    color: #ffffff;
    margin: 2px;
    border-radius: 4px;
}

QMenuBar::item:disabled {
    color: #999999;
}

QMenu {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px;
    min-width: 220px;
    color: #cccccc;
    font-size: 13px;
}

QMenu::item {
    padding: 6px 12px 6px 12px;
    margin: 0px 2px;
    border-radius: 2px;
    color: #cccccc;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #999999;
}

/* Menu separators */
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 6px 0px 6px 0px;
}

/* Menu item indicators (for checkable items) */
QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 6px;
}

QMenu::indicator:checked {
    image: none; /* Would use checkmark icon if available */
    background-color: #007acc;
    border: 1px solid #007acc;
    border-radius: 2px;
}

QMenu::indicator:unchecked {
    background-color: transparent;
    border: 1px solid #454545;
    border-radius: 2px;
}

QTabBar {
    background-color: #252526;
    border-bottom: 1px solid #454545;
    font-size: 13px;
}

QTabBar::tab {
    padding: 10px 16px 8px 16px;
    margin: 0px;
    min-width: 80px;
    max-width: 200px;
    border: none;
    border-bottom: 2px solid transparent;
    background-color: #2d2d30;
    color: #999999;
    font-size: 13px;
    font-weight: 400;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #007acc;
    background-color: #1e1e1e;
}

QTabBar::tab:hover:!selected {
    color: #cccccc;
    background-color: #2a2a2a;
}

QTabBar::tab:disabled {
    color: #6c6c6c;
}

/* Tab close button */
QTabBar::close-button {
    image: none;
    background-color: transparent;
    width: 14px;
    height: 14px;
    margin: 2px;
}

QTabBar::close-button:hover {
    background-color: #454545;
    border-radius: 2px;
}

QTabBar::close-button:pressed {
    background-color: #007acc;
}

/* Tab Widget - container for tabs */
QTabWidget {
    background-color: #1e1e1e;
}

QTabWidget::pane {
    border: 1px solid #454545;
    border-top: none;
    background-color: #1e1e1e;
}

QTabWidget::tab-bar {
    alignment: left;
}

QToolBar {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 0px;
    padding: 2px;
    spacing: 2px;
}

QToolBar::handle {
    background-color: #454545;
    width: 4px;
    margin: 4px 2px;
}

QToolBar::separator {
    background-color: #454545;
    width: 1px;
    margin: 4px 2px;
}

/* Tool Buttons in toolbars */
QToolButton {
    padding: 4px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: transparent;
    color: #cccccc;
}

QToolButton:hover {
    background-color: #2a2a2a;
    border-color: #454545;
}

QToolButton:pressed {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

QToolButton:checked {
    background-color: #094771;
    border-color: #007acc;
    color: #ffffff;
}

QToolButton[popupMode="1"] { /* MenuButtonPopup */
    padding-right: 20px;
}

QToolButton::menu-button {
    border: 1px solid transparent;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    width: 16px;
}

QToolButton::menu-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
}

QToolButton::menu-arrow:hover {
    border-top-color: #ffffff;
}
