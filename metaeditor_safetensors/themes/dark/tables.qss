/* 
Dark Theme - Data Views
========================

VS Code inspired styling for tables, lists, trees, and scrollbars.
Based on VS Code's monaco-list and table components.
*/

/* Table Widgets - VS Code table/list style */
QTableWidget,
QTreeWidget,
QListWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #454545;
    gridline-color: #454545;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    color: #cccccc;
    font-size: 13px;
    outline: none;
}

/* Individual items in lists/tables */
QTableWidget::item,
QTreeWidget::item,
QListWidget::item {
    padding: 4px 8px;
    min-height: 22px;
    border: none;
    color: #cccccc;
    background-color: transparent;
}

/* Selected items - VS Code selection blue */
QTableWidget::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* Hover effect */
QTableWidget::item:hover,
QTreeWidget::item:hover,
QListWidget::item:hover {
    background-color: #2a2a2a;
}

/* Focus indicator */
QTableWidget::item:focus,
QTreeWidget::item:focus,
QListWidget::item:focus {
    background-color: #094771;
    outline: 1px solid #007acc;
}

/* Alternating row colors */
QTableWidget::item:alternate,
QTreeWidget::item:alternate,
QListWidget::item:alternate {
    background-color: #252526;
}

/* Header styling - VS Code header look */
QHeaderView::section {
    background-color: #252526;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 12px;
    color: #cccccc;
    min-height: 24px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background-color: #2a2a2a;
}

QHeaderView::section:pressed {
    background-color: #094771;
}

/* Sort indicators */
QHeaderView::up-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #cccccc;
}

QHeaderView::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #cccccc;
}

/* Tree Widget specific styling */
QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    border-image: none;
    border-right: 1px solid #454545;
}

QTreeWidget::branch:has-siblings:adjoins-item {
    border-image: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
    border-bottom: 1px solid #454545;
}

/* Tree expansion arrows */
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}

/* VS Code style scrollbars */
QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 14px;
    border: none;
    border-radius: 0px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 7px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #6c6c6c;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 7px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #6c6c6c;
}

/* Remove scrollbar arrows - VS Code style */
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* List Widget specific improvements */
QListWidget {
    show-decoration-selected: 1;
    outline: none;
}

QListWidget::item {
    border-bottom: 1px solid transparent;
    padding: 6px 12px;
}

QListWidget::item:selected {
    border: none;
    background-color: #264f78;
}

/* Table corner button */
QTableView QTableCornerButton::section {
    background-color: #252526;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
}

/* Abstract Item View base styling */
QAbstractItemView {
    background-color: #1e1e1e;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    outline: none;
}

QAbstractItemView::item {
    border: none;
    padding: 2px;
}

QAbstractItemView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

QAbstractItemView::item:hover {
    background-color: #2a2a2a;
}

/* Progress bar in lists/tables */
QProgressBar {
    background-color: #3c3c3c;
    border: 1px solid #454545;
    border-radius: 2px;
    text-align: center;
    font-size: 11px;
    color: #cccccc;
}

QProgressBar::chunk {
    background-color: #007acc;
    border-radius: 1px;
}
