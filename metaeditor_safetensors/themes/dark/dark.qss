/* 
Dark Theme 
=========================

Base colors and fundamental widget styling

Color Palette Reference:
- Background: #1e1e1e
- Sidebar: #252526
- Borders: #454545
- Text Primary: #cccccc
- Text Secondary: #999999
- Accent: #007acc
*/

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #cccccc;
    background-color: #1e1e1e;
}

QDialog {
    border: 1px solid #454545;
    border-radius: 3px;
}

QGroupBox {
    border: 1px solid #454545;
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 17px;
    font-size: 12px;
    background-color: rgba(255, 255, 255, 0.02);
    color: #cccccc;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #cccccc;
}

QLabel {
    color: #cccccc;
    background-color: transparent;
}

QLabel[class="description"] {
    color: #999999;
    font-size: 13px;
}

QLabel[class="note"] {
    font-size: 12px;
}

QLabel[class="heading"] {
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
}

QLabel[class="title"] {
    color: #ffffff;
    font-size: 20px;
    font-weight: 600;
}

/* Error/warning/info message styling */
QWidget[messageType="error"] {
    background-color: #5a1d1d;
    border-left: 3px solid #f14c4c;
    color: #ffffff;
}

QWidget[messageType="warning"] {
    background-color: #5d4e1a;
    border-left: 3px solid #ffcc02;
    color: #ffffff;
}

QWidget[messageType="info"] {
    background-color: #1e3a5f;
    border-left: 3px solid #007acc;
    color: #ffffff;
}

QWidget[messageType="success"] {
    background-color: #1e5f2e;
    border-left: 3px solid #89d185;
    color: #ffffff;
}

/* 
 Button Styles
*/

/* Primary Button */
QPushButton {
    min-height: 26px;
    padding: 4px 11px;
    border: 1px solid #007acc;
    border-radius: 2px;
    line-height: 18px;
    background-color: #007acc;
    color: #ffffff;
    text-align: center;
}

QPushButton:hover {
    background-color: #005a9e;
    border-color: #005a9e;
}

QPushButton:pressed {
    background-color: #004578;
    border-color: #004578;
}

QPushButton:disabled {
    background-color: #454545;
    border-color: #454545;
    color: #999999;
    opacity: 0.4;
}

QPushButton[class="icon"] {
    min-width: 26px;
    min-height: 26px;
    padding: 3px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton[class="icon"]:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.1);
}

QPushButton[class="icon"]:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

QPushButton[class="icon-small"] {
    min-width: 16px;
    min-height: 16px;
    padding: 3px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton[class="icon-small"]:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.1);
}

QPushButton[class="icon-small"]:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

QLabel[class="clickable-image"] {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: transparent;    
}

QLabel[class="clickable-image"]:hover {
    border: 1px solid #454545;    
}

/* 
Input Controls
*/

QLineEdit,
QTextEdit,
QSpinBox {
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QDateTimeEdit {
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
}

QLineEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus {
    border-color: #007acc;
    background-color: #1e1e1e;
    outline: none;
}

/* Disabled state */
QLineEdit:disabled,
QTextEdit:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
    color: #999999;
}

