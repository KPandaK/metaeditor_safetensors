    min-height: 24px;
    padding: 4px 8px 4px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
}

QComboBox:focus {
    border-color: #007acc;
    background-color: #1e1e1e;
}

QComboBox:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
    color: #999999;
}

