} */

/* Text areas */
QTextEdit {
    min-height: 60px;
    padding: 8px;
    line-height: 19px;
}

/* Checkboxes - keep traditional style */
QCheckBox {
    spacing: 8px;
    font-size: 13px;
    color: #cccccc;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #3c3c3c;
    border-radius: 3px;
    background-color: #1e1e1e;
}

QCheckBox::indicator:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    image: none;
}

QCheckBox::indicator:hover:!checked {
    border-color: #505050;
    background-color: #2a2a2a;
}

QCheckBox::indicator:hover:checked {
    background-color: #106ebe;
    border-color: #106ebe;
}

QCheckBox::indicator:disabled {
    background-color: #2d2d30;
    border-color: #2e2e2e;
    opacity: 0.5;
}

QCheckBox:disabled {
    color: #808080;
}

/** Grouped radio buttons */
QRadioButton {
    spacing: 0px;
    font-size: 12px;
    color: #cccccc;
    padding: 4px 12px;
    border: 1px solid #3c3c3c;
    background-color: #2d2d30;
    min-height: 24px;
}

/* Hide the traditional radio indicator */
QRadioButton::indicator {
    width: 0px;
    height: 0px;
    border: none;
    background: transparent;
}

QRadioButton:checked {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

QRadioButton:hover:!checked {
    background-color: #3c3c3c;
    border-color: #505050;
}

QRadioButton:hover:checked {
    background-color: #106ebe;
    border-color: #106ebe;
}

QRadioButton:pressed {
    background-color: #005a9e;
    border-color: #005a9e;
}

QRadioButton:focus {
    outline: 2px solid #007acc;
    outline-offset: 2px;
}

QRadioButton:disabled {
    background-color: #2d2d30;
    border-color: #2e2e2e;
    color: #808080;
    opacity: 0.5;
}

/* SpinBox specific styling */
QSpinBox::up-button,
QSpinBox::down-button {
    width: 16px;
    background-color: #454545;
    border: none;
}

QSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid #cccccc;
}

QSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
}

/* 
Menus and Navigation
*/

QMenuBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #454545;
    padding: 0px;
    font-size: 13px;
    color: #cccccc;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 0px;
    color: #cccccc;
    background-color: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #2a2d2e;
    color: #ffffff;
    margin: 2px;
    border-radius: 4px;
}

QMenuBar::item:disabled {
    color: #999999;
}

QMenu {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 3px;
    padding: 4px;
    min-width: 220px;
    color: #cccccc;
    font-size: 13px;
}

QMenu::item {
    padding: 6px 12px 6px 12px;
    min-width: 220px;    
    border-radius: 2px;
    color: #cccccc;
}

QMenu::item:selected {
    background-color: #0078d4;
    color: #ffffff;
}

QMenu::item:disabled {
    color: #999999;
}

/* Menu separators */
QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 6px 0px 6px 0px;
}

/* Menu item indicators (for checkable items) */
QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 6px;
}

QMenu::indicator:checked {
    image: none; /* Would use checkmark icon if available */
    background-color: #007acc;
    border: 1px solid #007acc;
    border-radius: 2px;
}

QMenu::indicator:unchecked {
    background-color: transparent;
    border: 1px solid #454545;
    border-radius: 2px;
}

QTabBar {
    background-color: #252526;
    border-bottom: 1px solid #454545;
    font-size: 13px;
}

QTabBar::tab {
    padding: 10px 16px 8px 16px;
    margin: 0px;
    min-width: 80px;
    max-width: 200px;
    border: none;
    border-bottom: 2px solid transparent;
    background-color: #2d2d30;
    color: #999999;
    font-size: 13px;
    font-weight: 400;
}

QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #007acc;
    background-color: #1e1e1e;
}

QTabBar::tab:hover:!selected {
    color: #cccccc;
    background-color: #2a2a2a;
}

QTabBar::tab:disabled {
    color: #6c6c6c;
}

/* Tab close button */
QTabBar::close-button {
    image: none;
    background-color: transparent;
    width: 14px;
    height: 14px;
    margin: 2px;
}

QTabBar::close-button:hover {
    background-color: #454545;
    border-radius: 2px;
}

QTabBar::close-button:pressed {
    background-color: #007acc;
}

/* Tab Widget - container for tabs */
QTabWidget {
    background-color: #1e1e1e;
}

QTabWidget::pane {
    border: 1px solid #454545;
    border-top: none;
    background-color: #1e1e1e;
}

QTabWidget::tab-bar {
    alignment: left;
}

QToolBar {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 0px;
    padding: 2px;
    spacing: 2px;
}

QToolBar::handle {
    background-color: #454545;
    width: 4px;
    margin: 4px 2px;
}

QToolBar::separator {
    background-color: #454545;
    width: 1px;
    margin: 4px 2px;
}

/* Tool Buttons in toolbars */
QToolButton {
    padding: 4px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: transparent;
    color: #cccccc;
}

QToolButton:hover {
    background-color: #2a2a2a;
    border-color: #454545;
}

QToolButton:pressed {
    background-color: #007acc;
    border-color: #007acc;
    color: #ffffff;
}

QToolButton:checked {
    background-color: #094771;
    border-color: #007acc;
    color: #ffffff;
}

QToolButton[popupMode="1"] { /* MenuButtonPopup */
    padding-right: 20px;
}

QToolButton::menu-button {
    border: 1px solid transparent;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    width: 16px;
}

QToolButton::menu-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
}

QToolButton::menu-arrow:hover {
    border-top-color: #ffffff;
}

/* 
Data Views
*/

QTableWidget,
QTreeWidget,
QListWidget {
    background-color: #1e1e1e;
    alternate-background-color: #252526;
    border: 1px solid #454545;
    gridline-color: #454545;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    color: #cccccc;
    font-size: 13px;
    outline: none;
}

/* Individual items in lists/tables */
QTableWidget::item,
QTreeWidget::item,
QListWidget::item {
    padding: 4px 8px;
    min-height: 22px;
    border: none;
    color: #cccccc;
    background-color: transparent;
}

QTableWidget::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

/* Focus indicator */
QTableWidget::item:focus,
QTreeWidget::item:focus,
QListWidget::item:focus {
    background-color: #094771;
    outline: 1px solid #007acc;
}

/* Alternating row colors */
QTableWidget::item:alternate,
QTreeWidget::item:alternate,
QListWidget::item:alternate {
    background-color: #252526;
}

QHeaderView::section {
    background-color: #252526;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 12px;
    color: #cccccc;
    min-height: 24px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:hover {
    background-color: #2a2a2a;
}

QHeaderView::section:pressed {
    background-color: #094771;
}

/* Sort indicators */
QHeaderView::up-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #cccccc;
}

QHeaderView::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #cccccc;
}

/* Tree Widget specific styling */
QTreeWidget::branch {
    background-color: transparent;
}

QTreeWidget::branch:has-siblings:!adjoins-item {
    border-image: none;
    border-right: 1px solid #454545;
}

QTreeWidget::branch:has-siblings:adjoins-item {
    border-image: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
}

QTreeWidget::branch:!has-children:!has-siblings:adjoins-item {
    border-image: none;
    border-bottom: 1px solid #454545;
}

/* Tree expansion arrows */
QTreeWidget::branch:has-children:!has-siblings:closed,
QTreeWidget::branch:closed:has-children:has-siblings {
    image: none;
    border-image: none;
}

QTreeWidget::branch:open:has-children:!has-siblings,
QTreeWidget::branch:open:has-children:has-siblings {
    image: none;
    border-image: none;
}

QScrollBar:vertical {
    background-color: #1e1e1e;
    width: 14px;
    border: none;
    border-radius: 0px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #424242;
    border-radius: 7px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:vertical:pressed {
    background-color: #6c6c6c;
}

QScrollBar:horizontal {
    background-color: #1e1e1e;
    height: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #424242;
    border-radius: 7px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4f4f4f;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #6c6c6c;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* List Widget specific improvements */
QListWidget {
    show-decoration-selected: 1;
    outline: none;
}

QListWidget::item {
    border-bottom: 1px solid transparent;
    padding: 6px 12px;
}

QListWidget::item:selected {
    border: none;
    background-color: #264f78;
}

/* Table corner button */
QTableView QTableCornerButton::section {
    background-color: #252526;
    border: none;
    border-right: 1px solid #454545;
    border-bottom: 1px solid #454545;
}

/* Abstract Item View base styling */
QAbstractItemView {
    background-color: #1e1e1e;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    outline: none;
}

QAbstractItemView::item {
    border: none;
    padding: 2px;
}

QAbstractItemView::item:selected {
    background-color: #264f78;
    color: #ffffff;
}

QAbstractItemView::item:hover {
    background-color: #2a2a2a;
}

/* 
Miscellaneous Elements
*/

QStatusBar {
    min-height: 22px;
    background-color: #007acc;
    color: #ffffff;
    border: none;
    font-size: 12px;
    font-weight: 400;
    padding: 0px;
    margin: 0px;
}

QStatusBar::item {
    padding: 4px 8px;
    border: none;
    margin: 0px;
}

QToolTip {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #454545;
    padding: 8px 12px;
    border-radius: 3px;
    font-size: 13px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    max-width: 400px;
}

QProgressBar {
    background-color: #3c3c3c;
    border: 1px solid #454545;
    border-radius: 2px;
    text-align: center;
    color: #cccccc;
    font-size: 12px;
    font-weight: 400;
    min-height: 18px;
    max-height: 18px;
}

QProgressBar::chunk {
    background-color: #007acc;
    border-radius: 1px;
    margin: 1px;
}

QProgressBar:disabled {
    background-color: #2d2d30;
    color: #6a6a6a;
}

QProgressBar::chunk:disabled {
    background-color: #5a5a5a;
}

QSplitter::handle {
    background-color: #454545;
    border: none;
}

QSplitter::handle:horizontal {
    width: 1px;
    margin: 0px;
}

QSplitter::handle:vertical {
    height: 1px;
    margin: 0px;
}

QSplitter::handle:hover {
    background-color: #007acc;
}

QSplitter::handle:pressed {
    background-color: #0e639c;
}

/* Size grip - resize handle */
QSizeGrip {
    width: 16px;
    height: 16px;
    background-color: transparent;
    background-image: none;
}

/* Dockwidgets */
QDockWidget {
    background-color: #252526;
    border: 1px solid #454545;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    color: #cccccc;
}

QDockWidget::title {
    background-color: #2d2d30;
    border-bottom: 1px solid #454545;
    padding: 8px 12px;
    font-weight: 600;
    font-size: 13px;
    color: #cccccc;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 4px;
    margin: 2px;
    border-radius: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3e3e42;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: #094771;
}

/* Abstract scroll area */
QAbstractScrollArea {
    background-color: #1e1e1e;
    border: 1px solid #454545;
}

QAbstractScrollArea::corner {
    background-color: #252526;
    border: none;
}

QSlider {
    background-color: transparent;
}

QSlider::groove:horizontal {
    background-color: #3c3c3c;
    height: 4px;
    border-radius: 2px;
    border: none;
}

QSlider::handle:horizontal {
    background-color: #007acc;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: -4px 0px;
    border: none;
}

QSlider::handle:horizontal:hover {
    background-color: #1177bb;
}

QSlider::handle:horizontal:pressed {
    background-color: #0e639c;
}

QSlider::groove:vertical {
    background-color: #3c3c3c;
    width: 4px;
    border-radius: 2px;
    border: none;
}

QSlider::handle:vertical {
    background-color: #007acc;
    width: 12px;
    height: 12px;
    border-radius: 6px;
    margin: 0px -4px;
    border: none;
}

QSlider::handle:vertical:hover {
    background-color: #1177bb;
}

QSlider::handle:vertical:pressed {
    background-color: #0e639c;
}

/* Text browser and text edit areas */
QPlainTextEdit {
    background-color: #1e1e1e;
    border: 1px solid #454545;
    color: #cccccc;
    selection-background-color: #264f78;
    selection-color: #ffffff;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    line-height: 1.4;
}

QPlainTextEdit:focus {
    border-color: #007acc;
    outline: none;
}

/* Calendar widget */
QCalendarWidget {
    background-color: #252526;
    color: #cccccc;
    selection-background-color: #264f78;
    border: 1px solid #454545;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #cccccc;
    border: none;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #3e3e42;
}

QCalendarWidget QToolButton:pressed {
    background-color: #094771;
}

/* Custom widgets */
ImageWidget {
    background-color: #1e1e1e;
    padding: 0px;
    margin: 0px;
    border: none;
}

ImageWidget[hasImage="false"] {
    border: 2px dashed #454545;
    border-radius: 3px;
    background-color: #252526;
}