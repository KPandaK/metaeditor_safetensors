/* 
Dark Theme - Input Controls
============================

VS Code inspired input styling based on monaco-inputbox and related components.
Follows VS Code's input design patterns with proper focus states and visual hierarchy.
*/

/* Text Input Fields - based on VS Code's input styling */
QLineEdit,
QTextEdit,
QSpinBox {
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QDateTimeEdit {
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
}

/* Focus states - VS Code blue outline */
QLineEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus {
    border-color: #007acc;
    background-color: #1e1e1e;
    outline: none;
}

/* Hover states */
QLineEdit:hover,
QTextEdit:hover,
QDateTimeEdit:hover,
QSpinBox:hover {
    border-color: #007acc;
}

/* Disabled state */
QLineEdit:disabled,
QTextEdit:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
    color: #999999;
}

/* Placeholder text styling */
QLineEdit {
    placeholder-text-color: #999999;
}

QTextEdit {
    placeholder-text-color: #999999;
}

/* ComboBox styling - matches VS Code dropdown */
QComboBox {
    min-height: 24px;
    padding: 4px 8px 4px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    color: #cccccc;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #007acc;
}

QComboBox:focus {
    border-color: #007acc;
    background-color: #1e1e1e;
}

QComboBox:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
    color: #999999;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #454545;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: #454545;
}

QComboBox::drop-down:hover {
    background-color: #007acc;
    border-left-color: #007acc;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
}

QComboBox::down-arrow:hover {
    border-top-color: #ffffff;
}

/* ComboBox dropdown list */
QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #454545;
    border-radius: 3px;
    selection-background-color: #094771;
    selection-color: #ffffff;
    color: #cccccc;
    padding: 2px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 22px;
    padding: 2px 8px;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2a2d2e;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #094771;
}

/* Text areas */
QTextEdit {
    min-height: 60px;
    padding: 8px;
    line-height: 19px;
}

/* Checkboxes and Radio Buttons - VS Code style */
QCheckBox,
QRadioButton {
    spacing: 8px;
    font-size: 13px;
    color: #cccccc;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #454545;
    border-radius: 3px;
    background-color: #3c3c3c;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #007acc;
    background-color: #094771;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #007acc;
    border-color: #007acc;
}

QCheckBox::indicator:checked {
    image: none;
    /* Could use a checkmark image here if available */
}

QRadioButton::indicator:checked {
    background-color: #007acc;
    border: 4px solid #3c3c3c;
    background-clip: content;
}

/* Disabled checkboxes and radios */
QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
}

QCheckBox:disabled,
QRadioButton:disabled {
    color: #999999;
}

/* SpinBox specific styling */
QSpinBox::up-button,
QSpinBox::down-button {
    width: 16px;
    background-color: #454545;
    border: none;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #007acc;
}

QSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 4px solid #cccccc;
}

QSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid #cccccc;
}

QSpinBox::up-arrow:hover,
QSpinBox::down-arrow:hover {
    border-bottom-color: #ffffff;
    border-top-color: #ffffff;
}
