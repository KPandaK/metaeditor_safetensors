/* 
Dark Theme - Input Controls
============================

Input control styling 
*/

QLineEdit,
QTextEdit,
QSpinBox {
    min-height: 24px;
    padding: 4px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QDateTimeEdit {
    min-height: 24px;
    padding: 3px 8px;
    border: 1px solid #454545;
    border-radius: 2px;
    background-color: #3c3c3c;
}

QLineEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus {
    border-color: #007acc;
    background-color: #1e1e1e;
    outline: none;
}

/* Disabled state */
QLineEdit:disabled,
QTextEdit:disabled,
QDateTimeEdit:disabled,
QSpinBox:disabled {
    background-color: #2d2d30;
    border-color: #2d2d30;
    color: #999999;
}

