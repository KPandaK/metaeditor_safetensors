/*
Light Theme Base Styling
*/

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #202020;
    background-color: #fafafa;
}

QLabel {
    color: #202020;
    background-color: transparent;
}

QDialog {
    border: 1px solid #d0d0d0;
    border-radius: 3px;
    background-color: #ffffff;
}

QLabel[class="clickable-image"] {
    padding: 2px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: transparent;
}

QLabel[class="clickable-image"]:hover {
    border: 1px solid #d0d0d0;
}

QLabel#kofiLink {
    min-width: 100px;
    min-height: 56px;
    image: url(:/assets/support_me.png);
}

QLabel#githubLink {
    min-width: 163px;
    min-height: 40px;
    image: url(:/assets/GitHub_Lockup_Dark.png);
}
