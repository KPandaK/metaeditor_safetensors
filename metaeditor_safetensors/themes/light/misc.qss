/* 
Light Theme - Miscellaneous Elements
=====================================

Status bars, tooltips, progress bars, splitters, and other UI elements.
*/

QStatusBar {
    min-height: 22px;
    background-color: rgb(0, 120, 212);
    color: rgb(255, 255, 255);
    border: none;
    font-size: 12px;
}

QStatusBar::item {
    padding: 0px 8px;
    border: none;
}

QStatusBar QLabel {
    color: rgb(255, 255, 255);
    font-size: 12px;
}

QToolTip {
    background-color: rgb(255, 255, 255);
    border: 1px solid rgb(204, 204, 204);
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 12px;
    color: rgb(51, 51, 51);
    max-width: 320px;
}

QProgressBar {
    border: 1px solid rgb(204, 204, 204);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.1);
    text-align: center;
    font-size: 12px;
    color: rgb(51, 51, 51);
}

QProgressBar::chunk {
    background-color: rgb(0, 120, 212);
    border-radius: 1px;
}

QSplitter::handle:horizontal {
    background-color: rgb(204, 204, 204);
    width: 1px;
}

QSplitter::handle:vertical {
    background-color: rgb(204, 204, 204);
    height: 1px;
}

QSplitter::handle:hover {
    background-color: rgb(0, 120, 212);
}

QDialogButtonBox {
    padding: 12px 16px;
    background-color: rgba(0, 0, 0, 0.02);
    border-top: 1px solid rgb(204, 204, 204);
}

QDialogButtonBox QPushButton {
    min-width: 75px;
    margin: 0px 4px;
}

/* Custom widgets */
ImageWidget {
    background-color: rgb(255, 255, 255);
    padding: 0px;
    margin: 0px;
    border: 0px;
}

ImageWidget[hasImage="false"] {
    border: 1px dotted rgb(204, 204, 204);
    border-radius: 3px;
}
