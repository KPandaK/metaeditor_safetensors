/* 
Light Theme - Base Styles
=========================

Base colors and fundamental widget styling for the light theme.
*/

QWidget {
    background-color: rgb(255, 255, 255);
    color: rgb(51, 51, 51);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 400;
}

QMainWindow {
    background-color: rgb(255, 255, 255);
    color: rgb(51, 51, 51);
}

QDialog {
    background-color: rgb(255, 255, 255);
    color: rgb(51, 51, 51);
    border: 1px solid rgb(204, 204, 204);
}

QGroupBox {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid rgb(204, 204, 204);
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 16px;
    background-color: rgba(0, 0, 0, 0.02);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: rgb(51, 51, 51);
    background-color: rgb(255, 255, 255);
}

QLabel {
    color: rgb(51, 51, 51);
    background-color: transparent;
}

QLabel[class="description"] {
    color: rgb(102, 102, 102);
    font-size: 13px;
}
