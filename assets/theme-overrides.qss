/* 
VS Code-Inspired Theme Overrides
================================

This stylesheet provides custom overrides inspired by Visual Studio Code's 
design language, applied on top of PyQtDarkTheme. Emphasizes clean typography, 
consistent spacing, professional color usage, and modern UI elements.

Design Principles:
- Semantic color system with consistent hover/focus states  
- Modern typography with readable font sizes and spacing
- Clean borders and subtle visual hierarchy
- Accessible touch targets and keyboard navigation
*/

/* =================================================================
   Font Hierarchy and Basic Styling
   ================================================================= */

QWidget {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 400;
}

QGroupBox {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.02em;
}

QGroupBox::title {
    color: rgb(204, 204, 204);
    font-weight: 600;
}

QTabBar::tab {
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
}

QMenuBar, QMenu {
    font-size: 14px;
    font-weight: 400;
}

QLabel {
    font-size: 14px;
}

QLabel[class="description"] {
    color: rgb(153, 153, 153); /* Secondary text color */
    font-size: 13px;
}

/* =================================================================
   Input Widgets
   ================================================================= */

QLineEdit,
QTextEdit,
QDateTimeEdit,
QSpinBox {
    min-height: 26px;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
}

/* Focus states */
QLineEdit:focus,
QTextEdit:focus,
QDateTimeEdit:focus,
QSpinBox:focus {
    outline: 1px solid rgb(0, 120, 212);
    outline-offset: 0px;
    border-color: rgb(0, 120, 212);
}

/* Hover states - subtle background change */
QLineEdit:hover,
QTextEdit:hover,
QDateTimeEdit:hover,
QSpinBox:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Combo boxes with VS Code styling */
QComboBox {
    min-height: 26px;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QComboBox:focus {
    outline: 1px solid rgb(0, 120, 212);
    outline-offset: 0px;
    border-color: rgb(0, 120, 212);
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

/* Text areas */
QTextEdit {
    min-height: 80px;
    padding: 8px;
}

/* =================================================================
   MODERN BUTTON SYSTEM - VS Code-inspired button design
   ================================================================= */

/* Primary buttons following VS Code's design */
QPushButton {
    min-height: 28px;         /* VS Code button height */
    padding: 4px 14px;        /* VS Code button padding */
    border: 1px solid transparent;
    border-radius: 2px;       /* Minimal radius */
    font-weight: 400;
    background-color: rgb(14, 99, 156); /* VS Code primary button blue */
    color: white;
}

QPushButton:hover {
    background-color: rgb(0, 120, 212); /* Brighter blue on hover */
}

QPushButton:pressed {
    background-color: rgb(0, 103, 183); /* Darker blue when pressed */
}

QPushButton:focus {
    outline: 1px solid rgb(0, 120, 212);
    outline-offset: 1px;
}

/* Secondary buttons using CSS class system */
QPushButton[class="secondary"] {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(204, 204, 204);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

QPushButton[class="secondary"]:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.3);
}

/* Disabled state */
QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(109, 109, 109);
    border-color: transparent;
}

/* =================================================================
   REFINED CONTROL ELEMENTS - Clean checkboxes, radios, tabs
   ================================================================= */

/* VS Code-style checkboxes */
QCheckBox,
QRadioButton {
    spacing: 8px;
    font-size: 13px;
    color: rgb(204, 204, 204);
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;              /* VS Code checkbox size */
    height: 16px;
    border: 1px solid rgb(101, 101, 101);
    border-radius: 2px;       /* Square corners for checkboxes */
    background-color: rgba(255, 255, 255, 0.1);
}

QRadioButton::indicator {
    border-radius: 8px;       /* Round for radio buttons */
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: rgb(0, 120, 212);
    background-color: rgba(0, 120, 212, 0.1);
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: rgb(0, 120, 212);
    border-color: rgb(0, 120, 212);
}

/* Modern tab system inspired by VS Code */
QTabBar::tab {
    padding: 8px 16px;        /* VS Code tab padding */
    margin-right: 0px;        /* No gaps between tabs */
    min-width: 80px;
    border: none;
    border-bottom: 1px solid transparent;
    background-color: transparent;
    color: rgb(153, 153, 153); /* Inactive tab color */
}

QTabBar::tab:selected {
    color: rgb(255, 255, 255);  /* Active tab color */
    border-bottom: 1px solid rgb(0, 120, 212); /* VS Code accent */
    background-color: rgba(255, 255, 255, 0.05);
}

QTabBar::tab:hover:!selected {
    color: rgb(204, 204, 204);
    background-color: rgba(255, 255, 255, 0.03);
}

/* =================================================================
   PROFESSIONAL MENU SYSTEM - Clean, accessible menus  
   ================================================================= */

/* Menu bar styling */
QMenuBar {
    background-color: rgb(30, 30, 30);  /* VS Code title bar color */
    border-bottom: 1px solid rgb(69, 69, 69);
    padding: 0px;
}

QMenuBar::item {
    padding: 6px 12px;        /* VS Code menu padding */
    border-radius: 2px;
    color: rgb(204, 204, 204);
}

QMenuBar::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(255, 255, 255);
}

QMenuBar::item:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

/* Dropdown menus */
QMenu {
    background-color: rgb(37, 37, 38);  /* VS Code menu background */
    border: 1px solid rgb(69, 69, 69);
    border-radius: 3px;
    padding: 4px 0px;
    min-width: 160px;
}

QMenu::item {
    padding: 6px 12px 6px 24px; /* Space for icons */
    margin: 0px 4px;
    border-radius: 2px;
    color: rgb(204, 204, 204);
}

QMenu::item:selected {
    background-color: rgba(0, 120, 212, 0.8); /* VS Code selection blue */
    color: rgb(255, 255, 255);
}

QMenu::separator {
    height: 1px;
    background-color: rgb(69, 69, 69);
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 4px;
}

/* =================================================================
   SUBTLE VISUAL FEEDBACK - Tooltips and status elements
   ================================================================= */

QToolTip {
    background-color: rgb(45, 45, 45);  /* VS Code tooltip background */
    border: 1px solid rgb(69, 69, 69);
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 12px;
    color: rgb(204, 204, 204);
    max-width: 320px;
}

/* Status bar following VS Code design */
QStatusBar {
    min-height: 22px;         /* VS Code status bar height */
    background-color: rgb(0, 120, 212); /* VS Code blue */
    color: rgb(255, 255, 255);
    border: none;
    font-size: 12px;
}

QStatusBar::item {
    padding: 0px 8px;
    border: none;
}

QStatusBar QLabel {
    color: rgb(255, 255, 255);
    font-size: 12px;
}

/* =================================================================
   ENHANCED DIALOG SYSTEM - Professional dialog appearance
   ================================================================= */

/* Group boxes with VS Code styling */
QGroupBox {
    border: 1px solid rgb(69, 69, 69);
    border-radius: 3px;
    margin-top: 8px;
    padding-top: 16px;
    background-color: rgba(255, 255, 255, 0.02);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: rgb(204, 204, 204);
    background-color: rgb(30, 30, 30); /* Match parent background */
}

/* Dialog improvements */
QDialog {
    min-width: 420px;
    background-color: rgb(30, 30, 30);  /* VS Code dialog background */
    border: 1px solid rgb(69, 69, 69);
}

QDialogButtonBox {
    padding: 12px 16px;
    background-color: rgba(255, 255, 255, 0.02);
    border-top: 1px solid rgb(69, 69, 69);
}

QDialogButtonBox QPushButton {
    min-width: 75px;
    margin: 0px 4px;
}

/* =================================================================
   DATA DISPLAY ELEMENTS - Tables, lists, and content areas
   ================================================================= */

/* Thumbnail display with modern styling */
#thumbnailDisplay {
    border: 1px solid rgb(69, 69, 69);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.02);
    min-height: 120px;
    padding: 12px;
}

/* Tables and lists following VS Code patterns */
QTableWidget,
QTreeWidget,
QListWidget {
    background-color: rgb(30, 30, 30);
    alternate-background-color: rgba(255, 255, 255, 0.02);
    border: 1px solid rgb(69, 69, 69);
    gridline-color: rgb(69, 69, 69);
    selection-background-color: rgba(0, 120, 212, 0.3);
}

QTableWidget::item,
QTreeWidget::item,
QListWidget::item {
    padding: 4px 8px;
    min-height: 20px;
    border: none;
    color: rgb(204, 204, 204);
}

QTableWidget::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: rgba(0, 120, 212, 0.3);
    color: rgb(255, 255, 255);
}

QTableWidget::item:hover,
QTreeWidget::item:hover,
QListWidget::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QHeaderView::section {
    background-color: rgb(37, 37, 38);
    border: 1px solid rgb(69, 69, 69);
    padding: 6px 8px;
    font-weight: 600;
    color: rgb(204, 204, 204);
    min-height: 24px;
}

/* =================================================================
   REFINED INTERFACE ELEMENTS - Scrollbars, splitters, progress
   ================================================================= */

/* Modern scrollbars inspired by VS Code */
QScrollBar:vertical {
    background-color: rgba(255, 255, 255, 0.05);
    width: 14px;              /* VS Code scrollbar width */
    border: none;
    border-radius: 0px;       /* Square scrollbars */
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 7px;       /* Rounded handle */
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

QScrollBar:horizontal {
    background-color: rgba(255, 255, 255, 0.05);
    height: 14px;
    border: none;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 7px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.4);
}

/* Remove scrollbar arrows */
QScrollBar::add-line, QScrollBar::sub-line {
    border: none;
    background: none;
    width: 0px;
    height: 0px;
}

/* Clean splitter handles */
QSplitter::handle:horizontal {
    background-color: rgb(69, 69, 69);
    width: 1px;               /* Thin splitters like VS Code */
}

QSplitter::handle:vertical {
    background-color: rgb(69, 69, 69);
    height: 1px;
}

QSplitter::handle:hover {
    background-color: rgb(0, 120, 212);
}

/* Progress bars */
QProgressBar {
    border: 1px solid rgb(69, 69, 69);
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 12px;
    color: rgb(204, 204, 204);
}

QProgressBar::chunk {
    background-color: rgb(0, 120, 212); /* VS Code blue */
    border-radius: 1px;
}
